# Copy to .env (gitignored). Never commit real keys.
ODDS_API_KEY=
# regions to log (comma-sep: us,us2,eu,uk,au). us2 adds more US books.
ODDS_REGIONS=us
# prop markets logged per event inside the prop window
ODDS_PROP_MARKETS=player_points,player_rebounds,player_assists,player_threes,player_points_rebounds_assists
# cadence knobs (minutes / hours)
ODDS_MAIN_INTERVAL_MIN=30
ODDS_CLOSE_INTERVAL_MIN=5
ODDS_CLOSE_WINDOW_MIN=90
ODDS_PROP_WINDOW_HRS=24
ODDS_PROP_INTERVAL_MIN=60
# stop spending credits on props below this remaining-credit floor
ODDS_CREDIT_FLOOR=500
# FREE TIER: set to the plan's monthly credits (free = 500). Paces main-line
# polls to last the month and disables props entirely. 0 = paid, no pacing.
ODDS_MONTHLY_BUDGET=500
